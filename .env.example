# 复制为 .env 后填写。.env 不要提交到 git。

# 中转站密钥：变量名要和 providers.toml 里的 api_key_env 对应。
# 如果两种接口用的是同一个密钥，两行填一样的值即可。
OPENAI_RELAY_API_KEY=
CLAUDE_RELAY_API_KEY=

# 中转站地址：变量名要和 providers.toml 里的 base_url_env 对应。
# OpenAI 规范的地址通常以 /v1 结尾，Claude 规范的通常不带 /v1。
OPENAI_RELAY_BASE_URL=
CLAUDE_RELAY_BASE_URL=

# 可选：覆盖 providers.toml 的默认 profile / 模型
# LLM_PROFILE=claude-relay
# LLM_MODEL=

# 关闭 Pydantic AI 启动时打印的横幅
PYDANTIC_AI_NO_BANNER=1
